# Postgres connection used by the server. REQUIRED.
# Use a hosted database so pages survive if this machine or container dies:
#   Neon:      Dashboard > Connect > copy the connection string (pooled host is fine)
#   Supabase:  Project settings > Database > Connection string (URI)
# Keep ?sslmode=require on the end.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Max connections this server opens (hosted free tiers cap connections)
PG_POOL_MAX=5

# Where HTML blocks run. MUST be a different origin (in production: a different domain) from the app.
SANDBOX_URL=http://localhost:5174

# Set to 0 to stop new sign-ups on your server.
SIGNUP_OPEN=1

# Development only: a shared agent token that can open any page (ignored when NODE_ENV=production).
# In production, people create personal agent tokens in the app instead.
AGENT_TOKEN=dev-agent-token

# Neon Auth (optional): enables "Continue with Google". `neon deploy` writes these to .env.local.
# NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
# NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Built-in AI assistant: people's own API keys are encrypted with this before they are stored.
# Required in production. Use a long random string (openssl rand -base64 32) and keep it: changing it
# makes saved keys unreadable (people just paste them again).
# AI_KEY_SECRET=
# Allow assistant endpoints on private/local addresses (Ollama, LM Studio). Default: on in dev, off in production.
# AI_ALLOW_PRIVATE_ENDPOINTS=1
# Public address of the app, used in links sent to agents (mentions and webhooks). Render sets RENDER_EXTERNAL_URL automatically.
# PUBLIC_URL=https://livepage.example.com
# Allow agent webhooks to call private/loopback addresses in production (self-hosted setups on a LAN).
# WEBHOOK_ALLOW_PRIVATE=1
