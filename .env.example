# Postgres connection used by the server. REQUIRED.
# Use a hosted database so pages survive if this machine or container dies:
#   Neon:      Dashboard > Connect > copy the connection string (pooled host is fine)
#   Supabase:  Project settings > Database > Connection string (URI)
# Keep ?sslmode=require on the end.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Max connections this server opens (hosted free tiers cap connections)
PG_POOL_MAX=5

# Where HTML blocks run. MUST be a different origin (in production: a different domain) from the app.
SANDBOX_URL=http://localhost:5174

# Set to 0 to stop new sign-ups on your server.
SIGNUP_OPEN=1

# Development only: a shared agent token that can open any page (ignored when NODE_ENV=production).
# In production, people create personal agent tokens in the app instead.
AGENT_TOKEN=dev-agent-token
