{
  "name": "livepage",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "description": "Open-source, self-hostable writing canvas where people and AI agents edit one live page together, with sandboxed HTML/JS blocks.",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "dev:memory": "LIVEPAGE_MEMORY_STORE=1 SIGNUP_OPEN=1 pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "agent:demo": "pnpm --filter @livepage/agent demo",
    "agent:mcp": "pnpm --filter @livepage/agent mcp",
    "agent:docs": "pnpm --filter @livepage/agent docs",
    "check:responsive": "node scripts/responsive-check.mjs",
    "tokens:sync": "node scripts/sync-tokens.mjs",
    "check:tokens": "node scripts/sync-tokens.mjs --check",
    "check:perf": "node scripts/perf-check.mjs",
    "test": "pnpm -r --if-present test",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@neon/config": "^1.14.6",
    "@neon/env": "^2.1.9"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "playwright": "1.63.0"
  }
}
